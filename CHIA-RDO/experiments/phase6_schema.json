{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chialoops.ai/schemas/chia-rdo-phase6-experiment-v1.json",
  "title": "CHIA-RDO Phase-6 Experiment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "chia_run_id",
    "track",
    "policy_id",
    "policy_version",
    "hardware_configuration",
    "workload",
    "qp",
    "k",
    "p",
    "batches",
    "estimated_cycles",
    "rtl_cycles_per_event",
    "utilization",
    "bd_rate_percent",
    "psnr",
    "lut",
    "ff",
    "bram",
    "dsp",
    "fmax_mhz",
    "wns_ns",
    "result_status",
    "execution_backend",
    "gcp_worker",
    "estimated_cloud_cost_usd",
    "timestamp",
    "git"
  ],
  "properties": {
    "schema_version": {"const": "chia-rdo.phase6-experiment.v1"},
    "experiment_id": {"type": "string", "pattern": "^phase6-[a-z]-[0-9a-f]{16}$"},
    "parent_experiment_id": {"type": ["string", "null"]},
    "chia_run_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["A", "B"]},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "hardware_configuration": {
      "type": "object",
      "required": ["p", "pipeline_depth", "buffer_depth", "cost_width", "scheduler_architecture", "pe_architecture"],
      "properties": {
        "p": {"enum": [1, 2, 4, 8]},
        "pipeline_depth": {"enum": [1, 2, 4]},
        "buffer_depth": {"enum": [35, 48, 64]},
        "cost_width": {"enum": [48, 56]},
        "scheduler_architecture": {"enum": ["static", "batch_aware", "utilization_aware"]},
        "pe_architecture": {"type": "string"}
      }
    },
    "workload": {"type": "string"},
    "qp": {"type": ["array", "null"], "items": {"type": "integer"}},
    "k": {"type": ["array", "integer", "null"]},
    "p": {"enum": [1, 2, 4, 8]},
    "batches": {"type": ["number", "null"]},
    "estimated_cycles": {"type": ["number", "null"]},
    "rtl_cycles_per_event": {"type": ["number", "null"]},
    "utilization": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "bd_rate_percent": {"type": ["number", "null"]},
    "psnr": {"type": ["object", "null"]},
    "bitrate": {"type": ["number", "null"]},
    "lut": {"type": ["integer", "null"]},
    "ff": {"type": ["integer", "null"]},
    "bram": {"type": ["integer", "null"]},
    "dsp": {"type": ["integer", "null"]},
    "fmax_mhz": {"type": ["number", "null"]},
    "wns_ns": {"type": ["number", "null"]},
    "result_status": {"enum": ["PASS", "FAILED", "TIMEOUT", "CANCELLED"]},
    "execution_backend": {"enum": ["local", "gcp"]},
    "gcp_worker": {"type": ["string", "null"]},
    "estimated_cloud_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "actual_cloud_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "git": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {"commit": {"type": "string"}, "dirty": {"type": "boolean"}}
    }
  }
}
