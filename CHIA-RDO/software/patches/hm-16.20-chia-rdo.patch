+static Bool chiaRdoExhaustiveEnabled()
+{
+  const char *value = std::getenv("CHIA_RDO_EXHAUSTIVE");
+  return value != NULL && std::string(value) == "1";
+}
+
+static std::ofstream *chiaRdoTraceStream()
+{
+  static Bool initialized = false;
+  static std::ofstream stream;
+
+  if (!initialized)
+  {
+    initialized = true;
+    const char *path = std::getenv("CHIA_RDO_TRACE");
+    if (path != NULL && path[0] != '\0')
+    {
+      stream.open(path, std::ios::out | std::ios::trunc);
+      if (!stream)
+      {
+        std::cerr << "CHIA-RDO: could not open trace file " << path << std::endl;
+      }
+    }
+  }
+  return stream.is_open() ? &stream : NULL;
+}
