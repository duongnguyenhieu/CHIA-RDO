+static std::ofstream *chiaFullRdoTraceStream()
+{
+  static Bool initialized = false;
+  static std::ofstream stream;
+  if (!initialized)
+  {
+    initialized = true;
+    const char *path = std::getenv("CHIA_FULL_RDO_TRACE");
+    if (path != NULL && path[0] != '\0') stream.open(path, std::ios::out | std::ios::trunc);
+  }
+  return stream.is_open() ? &stream : NULL;
+}
+
+static Int64 chiaFullRdoNextSampleId = 0;
+static Int64 chiaFullRdoLastSampleId = -1;
+
+static Void chiaWriteFullRdoArray(std::ofstream &stream, const Pel *values, UInt stride)
+{
+  stream << '[';
+  for (UInt y = 0; y < 4; y++) for (UInt x = 0; x < 4; x++)
+  {
+    if (x != 0 || y != 0) stream << ',';
+    stream << Int(values[y * stride + x]);
+  }
+  stream << ']';
+}
+
+static Void chiaWriteFullRdoCoeffArray(std::ofstream &stream, const TCoeff *values)
+{
+  stream << '[';
+  for (UInt i = 0; i < 16; i++)
+  {
+    if (i != 0) stream << ',';
+    stream << values[i];
+  }
+  stream << ']';
+}
+
+static Void chiaWriteFullRdoBits(UInt bits, Double lambda, Double cost)
+{
+  std::ofstream *stream = chiaFullRdoTraceStream();
+  if (stream != NULL && chiaFullRdoLastSampleId >= 0)
+  {
+    *stream << std::setprecision(17)
+            << "{\"event\":\"full_rdo_bits\",\"sample_id\":" << chiaFullRdoLastSampleId
+            << ",\"rate_bits\":" << bits << ",\"lambda\":" << lambda
+            << ",\"rd_cost\":" << cost << "}\n";
+    chiaFullRdoLastSampleId = -1;
+  }
+}
+
 
