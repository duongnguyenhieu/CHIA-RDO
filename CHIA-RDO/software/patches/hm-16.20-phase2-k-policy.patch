+enum ChiaRdoPolicy
+{
+  CHIA_RDO_STOCK,
+  CHIA_RDO_EXHAUSTIVE,
+  CHIA_RDO_FIXED,
+  CHIA_RDO_ADAPTIVE_V0
+};
+
+struct ChiaRdoPolicyConfig
+{
+  ChiaRdoPolicy policy;
+  UInt fixedK;
+  UInt highK;
+  UInt mediumK;
+  UInt lowK;
+  Double highThreshold;
+  Double mediumThreshold;
+
+  ChiaRdoPolicyConfig()
+    : policy(CHIA_RDO_STOCK), fixedK(35), highK(4), mediumK(8), lowK(16),
+      highThreshold(0.088), mediumThreshold(0.045)
+  {
+    const char *name = std::getenv("CHIA_RDO_POLICY");
+    if (name == NULL || name[0] == '\0')
+    {
+      policy = chiaRdoExhaustiveEnabled() ? CHIA_RDO_EXHAUSTIVE : CHIA_RDO_STOCK;
+      return;
+    }
+    const std::string policyName(name);
+    if (policyName == "exhaustive") policy = CHIA_RDO_EXHAUSTIVE;
+    else if (policyName == "fixed") policy = CHIA_RDO_FIXED;
+    else if (policyName == "adaptive_v0") policy = CHIA_RDO_ADAPTIVE_V0;
+    else chiaFail("CHIA_RDO_POLICY must be exhaustive, fixed, or adaptive_v0");
+
+    if (policy == CHIA_RDO_FIXED) fixedK = parseUInt("CHIA_RDO_FIXED_K", 0);
+    if (policy == CHIA_RDO_ADAPTIVE_V0)
+    {
+      highThreshold = parseDouble("CHIA_RDO_HIGH_THRESHOLD", highThreshold);
+      mediumThreshold = parseDouble("CHIA_RDO_MEDIUM_THRESHOLD", mediumThreshold);
+      highK = parseUInt("CHIA_RDO_HIGH_K", highK);
+      mediumK = parseUInt("CHIA_RDO_MEDIUM_K", mediumK);
+      lowK = parseUInt("CHIA_RDO_LOW_K", lowK);
+      if (mediumThreshold > highThreshold) chiaFail("adaptive thresholds must satisfy medium <= high");
+    }
+  }
+
+  static Void chiaFail(const char *message)
+  {
+    std::cerr << "CHIA-RDO: " << message << std::endl;
+    std::exit(EXIT_FAILURE);
+  }
+
+  static UInt parseUInt(const char *name, UInt defaultValue)
+  {
+    const char *text = std::getenv(name);
+    if ((text == NULL || text[0] == '\0') && defaultValue != 0) return defaultValue;
+    char *end = NULL;
+    const long value = text == NULL ? 0 : std::strtol(text, &end, 10);
+    if (text == NULL || text[0] == '\0' || end == NULL || end[0] != '\0' || value < 1 || value > 35)
+    {
+      chiaFail("K values must be integers in [1,35]");
+    }
+    return UInt(value);
+  }
+
+  static Double parseDouble(const char *name, Double defaultValue)
+  {
+    const char *text = std::getenv(name);
+    if (text == NULL || text[0] == '\0') return defaultValue;
+    char *end = NULL;
+    const Double value = std::strtod(text, &end);
+    if (end == NULL || end[0] != '\0' || !std::isfinite(value) || value < 0.0)
+    {
+      chiaFail("adaptive thresholds must be finite nonnegative numbers");
+    }
+    return value;
+  }
+};
+
+static const ChiaRdoPolicyConfig &chiaRdoPolicyConfig()
+{
+  static const ChiaRdoPolicyConfig config;
+  return config;
+}
+
+static const char *chiaRdoPolicyName(ChiaRdoPolicy policy)
+{
+  switch (policy)
+  {
+    case CHIA_RDO_EXHAUSTIVE: return "exhaustive";
+    case CHIA_RDO_FIXED: return "fixed";
+    case CHIA_RDO_ADAPTIVE_V0: return "adaptive_v0";
+    default: return "stock";
+  }
+}
